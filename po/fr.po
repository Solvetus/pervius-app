#: pervius/ui/window.py:863
msgid ""
"The system service reported an error. Disarm, then arm the kill switch again."
msgstr ""
"Le service système a signalé une erreur. Désarmez puis réarmez le coupe-"
"circuit."

#: pervius/ui/window.py:868
#, python-brace-format
msgid "Armed — {0} VPN endpoint allowed; all other traffic is blocked."
msgid_plural "Armed — {0} VPN endpoints allowed; all other traffic is blocked."
msgstr[0] ""
"Armé — {0} adresse de serveur VPN autorisée ; tout autre trafic est bloqué."
msgstr[1] ""
"Armé — {0} adresses de serveur VPN autorisées ; tout autre trafic est bloqué."

#: pervius/ui/window.py:873
msgid "Armed — VPN not connected; internet traffic is blocked."
msgstr "Armé — VPN non connecté ; le trafic Internet est bloqué."

#: pervius/ui/window.py:875
msgid "Off — normal network traffic is allowed."
msgstr "Désactivé — le trafic réseau normal est autorisé."

#: pervius/ui/window.py:898 pervius/ui/window.py:919 pervius/ui/window.py:1038
#: pervius/ui/window.py:3408
msgid "A kill-switch operation is already in progress."
msgstr "Une opération sur le coupe-circuit est déjà en cours."

#: pervius/ui/window.py:933
msgid "Local network traffic will remain allowed."
msgstr "Le trafic du réseau local restera autorisé."

#: pervius/ui/window.py:935
msgid "Local network traffic will also be blocked."
msgstr "Le trafic du réseau local sera également bloqué."

#: pervius/ui/window.py:938
msgid "Enable the kill switch?"
msgstr "Activer le coupe-circuit ?"

#: pervius/ui/window.py:941
#, python-brace-format
msgid ""
"All traffic outside the VPN will be blocked, including DNS and global IPv6. "
"If the VPN is not connected, normal internet access will stop until you "
"disarm it or connect. {0}"
msgstr ""
"Tout le trafic hors VPN sera bloqué, y compris le DNS et le trafic IPv6 "
"global. Si le VPN n’est pas connecté, l’accès normal à Internet sera coupé "
"jusqu’à ce que vous désarmiez le coupe-circuit ou que vous vous connectiez. "
"{0}"

#: pervius/ui/window.py:947
msgid "Enable"
msgstr "Activer"

#: pervius/ui/window.py:961
msgid "Disable the kill switch?"
msgstr "Désactiver le coupe-circuit ?"

#: pervius/ui/window.py:963
msgid ""
"The firewall rules will be removed and normal network traffic will be "
"allowed again, even if the VPN is down."
msgstr ""
"Les règles du pare-feu seront supprimées et le trafic réseau normal sera de "
"nouveau autorisé, même si le VPN est coupé."

#: pervius/ui/window.py:968
msgid "Disable"
msgstr "Désactiver"

