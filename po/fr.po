#, python-brace-format
msgid "The NetworkManager secret agent could not be registered: {0}"
msgstr "Impossible d’enregistrer l’agent de secrets NetworkManager : {0}"

#: pervius/ui/window.py:831 pervius/ui/window.py:1029
msgid "The kill-switch service is unavailable."
msgstr "Le service du coupe-circuit est indisponible."

#: pervius/ui/window.py:833
