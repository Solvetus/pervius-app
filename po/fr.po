#: pervius/ui/window.py:583
msgid ""
"UDP is the usual default. Try TCP only when UDP is blocked. Both carry the "
"same encrypted tunnel; see Help for details."
msgstr ""
"UDP est le choix habituel par défaut. N’essayez TCP que si UDP est bloqué. "
"Les deux transportent le même tunnel chiffré ; consultez l’aide pour en "
"savoir plus."

#: pervius/ui/window.py:598
msgid "UDP — lower latency; the usual choice."
msgstr "UDP — latence plus faible ; le choix habituel."

#: pervius/ui/window.py:600
msgid "TCP — use when the network blocks or filters UDP."
msgstr "TCP — à utiliser quand le réseau bloque ou filtre UDP."

#: pervius/ui/window.py:617 pervius/ui/window.py:1995
msgid "Credentials not set"
msgstr "Identifiants non définis"

#: pervius/ui/window.py:619
msgid "Edit"
msgstr "Modifier"

#: pervius/ui/window.py:628 pervius/ui/window.py:1697
msgid "Reconnect automatically"
msgstr "Reconnexion automatique"

#: pervius/ui/window.py:631 pervius/ui/window.py:1700
msgid ""
"Retry after an unexpected drop, with increasing delays. Manual disconnects "
"and failed first attempts never retry."
msgstr ""
"Réessayer après une coupure inattendue, avec des délais croissants. Aucune "
"nouvelle tentative après une déconnexion manuelle ou l’échec d’une première "
"tentative."

#: pervius/ui/window.py:644
msgid "Security"
msgstr "Sécurité"

#: pervius/ui/window.py:646 pervius/ui/window.py:1529 pervius/ui/window.py:3057
msgid "Kill switch"
msgstr "Coupe-circuit"

#: pervius/ui/window.py:647
msgid "Checking the system service…"
msgstr "Vérification du service système…"

#: pervius/ui/window.py:654
msgid "Allow local network"
msgstr "Autoriser le réseau local"

#: pervius/ui/window.py:656
msgid "Permit RFC 1918/ULA traffic while the kill switch is armed."
msgstr "Autoriser le trafic RFC 1918/ULA lorsque le coupe-circuit est armé."

#: pervius/ui/window.py:665
msgid "Traffic outside the VPN is blocked"
msgstr "Le trafic hors VPN est bloqué"

#: pervius/ui/window.py:668
msgid ""
"Only the VPN servers, the tunnel, the interfaces you always allow, DHCP and "
"link control may pass. DNS outside the tunnel and global IPv6 are blocked."
msgstr ""
"Seuls les serveurs VPN, le tunnel, les interfaces toujours autorisées, DHCP "
"et le contrôle de liaison peuvent passer. Le DNS hors du tunnel et le trafic "
"IPv6 global sont bloqués."

#: pervius/ui/window.py:705
#, python-brace-format
msgid ""
"{0} {1} · independent project, not affiliated with the VPN provider · "
"catalogue source: vpn.ncapi.io"
msgstr ""
"{0} {1} · projet indépendant, non affilié au fournisseur VPN · source du "
"catalogue : vpn.ncapi.io"

