#: pervius/config.py:19
msgid "Unofficial Linux client for FastVPN."
msgstr "Cliente no oficial de FastVPN para Linux."

#: pervius/config.py:24 data/com.solvetus.Pervius.metainfo.xml.in:31
msgid ""
"Pervius is an independent open-source project by Solvetus Labs. It is not "
"affiliated with, endorsed by, or sponsored by Namecheap, Inc. FastVPN is a "
"trademark of Namecheap, Inc."
msgstr ""
"Pervius es un proyecto de código abierto independiente de Solvetus Labs. No "
"está afiliado a Namecheap, Inc., ni avalado ni patrocinado por esta empresa. "
"FastVPN es una marca comercial de Namecheap, Inc."

