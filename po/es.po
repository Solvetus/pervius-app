#: pervius/ui/window.py:629
msgid "Protocol"
msgstr "Protocolo"

#: pervius/ui/window.py:632
msgid ""
"UDP is the usual default. Try TCP only when UDP is blocked. Both carry the "
"same encrypted tunnel; see Help for details."
msgstr ""
"UDP es la opción habitual. Pruebe TCP solo si UDP está bloqueado. Ambos "
"transportan el mismo túnel cifrado; consulte la Ayuda para obtener más "
"detalles."

#: pervius/ui/window.py:647
msgid "UDP — lower latency; the usual choice."
msgstr "UDP — menor latencia; la opción habitual."

#: pervius/ui/window.py:649
msgid "TCP — use when the network blocks or filters UDP."
msgstr "TCP — para redes que bloquean o filtran UDP."

#: pervius/ui/window.py:666 pervius/ui/window.py:2038
msgid "Credentials not set"
msgstr "Sin credenciales configuradas"

#: pervius/ui/window.py:668
msgid "Edit"
msgstr "Editar"

#: pervius/ui/window.py:677 pervius/ui/window.py:1745
msgid "Reconnect automatically"
msgstr "Reconectar automáticamente"

#: pervius/ui/window.py:680 pervius/ui/window.py:1748
msgid ""
"Retry after an unexpected drop, with increasing delays. Manual disconnects "
"and failed first attempts never retry."
msgstr ""
"Se reintenta tras un corte inesperado, con esperas cada vez más largas. "
"Nunca se reintenta tras una desconexión manual ni cuando falla el primer "
"intento."

#: pervius/ui/window.py:693
msgid "Security"
msgstr "Seguridad"

#: pervius/ui/window.py:695 pervius/ui/window.py:1577 pervius/ui/window.py:3095
msgid "Kill switch"
msgstr "Interruptor de emergencia"

#: pervius/ui/window.py:696
msgid "Checking the system service…"
msgstr "Comprobando el servicio del sistema…"

#: pervius/ui/window.py:703
msgid "Allow local network"
msgstr "Permitir la red local"

#: pervius/ui/window.py:705
msgid "Permit RFC 1918/ULA traffic while the kill switch is armed."
msgstr ""
"Permitir el tráfico RFC 1918/ULA mientras el interruptor de emergencia esté "
"activado."

#: pervius/ui/window.py:714
msgid "Traffic outside the VPN is blocked"
msgstr "El tráfico fuera de la VPN está bloqueado"

#: pervius/ui/window.py:717
msgid ""
"Only the VPN servers, the tunnel, the interfaces you always allow, DHCP and "
"link control may pass. DNS outside the tunnel and global IPv6 are blocked."
msgstr ""
"Solo pueden pasar los servidores VPN, el túnel, las interfaces siempre "
"permitidas, DHCP y el control del enlace. Se bloquean el DNS fuera del túnel "
"y el IPv6 global."

#. Translators: footer, first line; {0} is the app name, {1} its version.
