msgstr "Não selecionada"

#: pervius/ui/window.py:564
msgid "Change"
msgstr "Alterar"

#: pervius/ui/window.py:576
msgid "UDP is the usual default. Try TCP only when UDP is blocked. Both carry the same encrypted tunnel; see Help for details."
msgstr "O UDP é a predefinição habitual. Experimente o TCP apenas se o UDP estiver bloqueado. Ambos transportam o mesmo túnel encriptado; consulte a Ajuda para mais detalhes."

#: pervius/ui/window.py:591
msgid "UDP — lower latency; the usual choice."
msgstr "UDP — menor latência; a escolha habitual."

#: pervius/ui/window.py:593
msgid "TCP — use when the network blocks or filters UDP."
msgstr "TCP — para quando a rede bloqueia ou filtra o UDP."

#: pervius/ui/window.py:610 pervius/ui/window.py:1907
msgid "Credentials not set"
msgstr "Credenciais não definidas"

#: pervius/ui/window.py:612
msgid "Edit"
msgstr "Editar"

#: pervius/ui/window.py:621 pervius/ui/window.py:1599
msgid "Reconnect automatically"
msgstr "Religar automaticamente"

#: pervius/ui/window.py:624 pervius/ui/window.py:1602
msgid "Retry after an unexpected drop, with increasing delays. Manual disconnects and failed first attempts never retry."
msgstr "Tenta novamente após uma quebra inesperada, com intervalos cada vez maiores. Não há novas tentativas se a ligação for terminada manualmente ou se a primeira tentativa falhar."

#: pervius/ui/window.py:637
msgid "Security"
msgstr "Segurança"

#: pervius/ui/window.py:639 pervius/ui/window.py:1433 pervius/ui/window.py:2844
msgid "Kill switch"
msgstr "Interruptor de emergência"

#: pervius/ui/window.py:640
msgid "Checking the system service…"
msgstr "A verificar o serviço do sistema…"

#: pervius/ui/window.py:647
msgid "Allow local network"
msgstr "Permitir rede local"

#: pervius/ui/window.py:649
msgid "Permit RFC 1918/ULA traffic while the kill switch is armed."
msgstr "Permitir tráfego RFC 1918/ULA enquanto o interruptor de emergência estiver ativo."

#: pervius/ui/window.py:658
msgid "Traffic outside the VPN is blocked"
msgstr "O tráfego fora da VPN é bloqueado"

#: pervius/ui/window.py:661
msgid "Only the VPN servers, the tunnel, the interfaces you always allow, DHCP and link control may pass. DNS outside the tunnel and global IPv6 are blocked."
msgstr "Só passam os servidores VPN, o túnel, as interfaces sempre permitidas, o DHCP e o tráfego de controlo da ligação de rede. O DNS fora do túnel e o IPv6 global são bloqueados."

#: pervius/ui/window.py:698
#, python-brace-format
msgid "{0} {1} · independent project, not affiliated with the VPN provider · catalogue source: vpn.ncapi.io"
msgstr "{0} {1} · projeto independente, não afiliado ao fornecedor da VPN · origem do catálogo: vpn.ncapi.io"

