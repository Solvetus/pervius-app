msgstr "Serviço do sistema indisponível; o pacote opcional não está ativo."

#: pervius/ui/window.py:905
msgid "Applying…"
msgstr "A aplicar…"

#: pervius/ui/window.py:908
msgid ""
"The system service reported an error. Disarm, then arm the kill switch again."
msgstr ""
"O serviço do sistema comunicou um erro. Desative e volte a ativar o "
"interruptor de emergência."

#: pervius/ui/window.py:913
#, python-brace-format
msgid "Armed — {0} VPN endpoint allowed; all other traffic is blocked."
msgid_plural "Armed — {0} VPN endpoints allowed; all other traffic is blocked."
msgstr[0] ""
"Ativo — {0} endereço de servidor VPN permitido; todo o restante tráfego é "
"bloqueado."
msgstr[1] ""
"Ativo — {0} endereços de servidores VPN permitidos; todo o restante tráfego "
"é bloqueado."

#: pervius/ui/window.py:918
msgid "Armed — VPN not connected; internet traffic is blocked."
msgstr "Ativo — VPN não ligada; o tráfego de Internet é bloqueado."

#: pervius/ui/window.py:920
msgid "Off — normal network traffic is allowed."
msgstr "Desativado — o tráfego de rede normal é permitido."

#: pervius/ui/window.py:943 pervius/ui/window.py:964 pervius/ui/window.py:1083
#: pervius/ui/window.py:3466
msgid "A kill-switch operation is already in progress."
msgstr "Já está em curso uma operação do interruptor de emergência."

#: pervius/ui/window.py:978
msgid "Local network traffic will remain allowed."
msgstr "O tráfego da rede local continuará permitido."

#: pervius/ui/window.py:980
msgid "Local network traffic will also be blocked."
msgstr "O tráfego da rede local também será bloqueado."

#: pervius/ui/window.py:983
msgid "Enable the kill switch?"
msgstr "Ativar o interruptor de emergência?"

#: pervius/ui/window.py:986
#, python-brace-format
msgid ""
"All traffic outside the VPN will be blocked, including DNS and global IPv6. "
"If the VPN is not connected, normal internet access will stop until you "
"disarm it or connect. {0}"
msgstr ""
"Todo o tráfego fora da VPN será bloqueado, incluindo o DNS e o IPv6 global. "
"Se a VPN não estiver ligada, o acesso normal à Internet ficará interrompido "
"até desativar o interruptor ou estabelecer a ligação. {0}"

#: pervius/ui/window.py:992
msgid "Enable"
msgstr "Ativar"

#: pervius/ui/window.py:1006
msgid "Disable the kill switch?"
msgstr "Desativar o interruptor de emergência?"

#: pervius/ui/window.py:1008
msgid ""
"The firewall rules will be removed and normal network traffic will be "
"allowed again, even if the VPN is down."
msgstr ""
"As regras da firewall serão removidas e o tráfego de rede normal voltará a "
"ser permitido, mesmo que a VPN esteja desligada."

#: pervius/ui/window.py:1013
msgid "Disable"
msgstr "Desativar"

