#: pervius/config.py:19
msgid "Unofficial Linux client for FastVPN."
msgstr "Cliente não oficial do FastVPN para Linux."

#: pervius/config.py:24 data/com.solvetus.Pervius.metainfo.xml.in:31
msgid "Pervius is an independent open-source project by Solvetus Labs. It is not affiliated with, endorsed by, or sponsored by Namecheap, Inc. FastVPN is a trademark of Namecheap, Inc."
msgstr "O Pervius é um projeto independente de código aberto da Solvetus Labs. Não está afiliado à Namecheap, Inc., nem é por ela endossado ou patrocinado. FastVPN é uma marca comercial da Namecheap, Inc."

