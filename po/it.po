#: pervius/ui/account.py:88
msgid "The password is sent to NetworkManager only when the VPN is activated. It is never written to the NetworkManager profile."
msgstr "La password viene inviata a NetworkManager solo quando si attiva la VPN e non viene mai scritta nel profilo di NetworkManager."

#: pervius/ui/account.py:93
msgid "Username"
msgstr "Nome utente"

#: pervius/ui/account.py:100 pervius/ui/account.py:108
msgid "Password"
msgstr "Password"

#: pervius/ui/account.py:101
msgid "Replace"
msgstr "Sostituisci"

#: pervius/ui/account.py:111
msgid "Save password in the desktop keyring"
msgstr "Salva la password nel portachiavi del desktop"

#: pervius/ui/account.py:120
msgid "Forget Saved Password…"
msgstr "Dimentica password salvata…"

#: pervius/ui/account.py:141
msgid "Credentials are not verified until a connection succeeds. Nothing is sent to Solvetus Labs; Pervius has no servers of its own."
msgstr "Le credenziali non vengono verificate finché una connessione non va a buon fine. Nulla viene inviato a Solvetus Labs: Pervius non dispone di server propri."

#: pervius/ui/account.py:170
msgid "Saved in the keyring"
msgstr "Salvata nel portachiavi"

#: pervius/ui/account.py:172
msgid "Kept for this session only"
msgstr "Conservata solo per questa sessione"

#: pervius/ui/account.py:179
msgid "The desktop keyring is unavailable; the password will be session-only."
msgstr "Il portachiavi del desktop non è disponibile: la password verrà conservata solo per questa sessione."

#: pervius/ui/account.py:183
msgid "If unavailable, the password is kept only for this session."
msgstr "Se il portachiavi non è disponibile, la password viene conservata solo per questa sessione."

#: pervius/ui/account.py:186
msgid "Replace the password to change where it is kept."
msgstr "Per cambiare il luogo in cui viene conservata, sostituire la password."

#: pervius/ui/account.py:208
msgid "Forget saved password?"
msgstr "Dimenticare la password salvata?"

#: pervius/ui/account.py:211
#, python-brace-format
msgid "This removes the desktop-keyring entry and the in-memory copy for {0}. An already-connected VPN stays up, but reauthentication may fail until you enter the password again."
msgstr "Verranno rimosse la voce nel portachiavi del desktop e la copia in memoria per {0}. Una VPN già connessa resta attiva, ma la riautenticazione potrebbe non riuscire finché la password non viene inserita di nuovo."

#: pervius/ui/account.py:217
msgid "Forget Password"
msgstr "Dimentica password"

#. Translators: {0} is a technical error message.
#: pervius/ui/account.py:234
#, python-brace-format
msgid "Could not remove the saved password: {0}"
msgstr "Impossibile rimuovere la password salvata: {0}"

#: pervius/ui/account.py:247
msgid "Enter your VPN username."
msgstr "Inserire il nome utente della VPN."

#: pervius/ui/account.py:256
msgid "Enter your VPN password."
msgstr "Inserire la password della VPN."

#. Translators: {0} is a technical error message.
#: pervius/ui/account.py:264
#, python-brace-format
msgid "The password is in memory for this session, but could not be saved: {0}"
msgstr "La password è in memoria per questa sessione, ma non è stato possibile salvarla: {0}"

