#: pervius/ui/window.py:576
msgid "UDP is the usual default. Try TCP only when UDP is blocked. Both carry the same encrypted tunnel; see Help for details."
msgstr "UDP è la scelta predefinita abituale. Provare TCP solo se UDP è bloccato. Entrambi trasportano lo stesso tunnel cifrato; per i dettagli consultare l'Aiuto."

#: pervius/ui/window.py:591
msgid "UDP — lower latency; the usual choice."
msgstr "UDP — latenza minore; la scelta abituale."

#: pervius/ui/window.py:593
msgid "TCP — use when the network blocks or filters UDP."
msgstr "TCP — da usare quando la rete blocca o filtra UDP."

#: pervius/ui/window.py:610 pervius/ui/window.py:1907
msgid "Credentials not set"
msgstr "Credenziali non impostate"

#: pervius/ui/window.py:612
msgid "Edit"
msgstr "Modifica"

#: pervius/ui/window.py:621 pervius/ui/window.py:1599
msgid "Reconnect automatically"
msgstr "Riconnetti automaticamente"

#: pervius/ui/window.py:624 pervius/ui/window.py:1602
msgid "Retry after an unexpected drop, with increasing delays. Manual disconnects and failed first attempts never retry."
msgstr "Riprova dopo un'interruzione imprevista, a intervalli crescenti. Non riprova mai dopo una disconnessione manuale o se il primo tentativo non riesce."

#: pervius/ui/window.py:637
msgid "Security"
msgstr "Sicurezza"

#: pervius/ui/window.py:639 pervius/ui/window.py:1433 pervius/ui/window.py:2844
msgid "Kill switch"
msgstr "Kill switch"

#: pervius/ui/window.py:640
msgid "Checking the system service…"
msgstr "Verifica del servizio di sistema…"

#: pervius/ui/window.py:647
msgid "Allow local network"
msgstr "Consenti la rete locale"

#: pervius/ui/window.py:649
msgid "Permit RFC 1918/ULA traffic while the kill switch is armed."
msgstr "Consente il traffico RFC 1918/ULA mentre il kill switch è attivo."

#: pervius/ui/window.py:658
msgid "Traffic outside the VPN is blocked"
msgstr "Il traffico esterno alla VPN è bloccato"

#: pervius/ui/window.py:661
msgid "Only the VPN servers, the tunnel, the interfaces you always allow, DHCP and link control may pass. DNS outside the tunnel and global IPv6 are blocked."
msgstr "Possono passare solo i server VPN, il tunnel, le interfacce sempre consentite, DHCP e il traffico di controllo del collegamento. Il DNS esterno al tunnel e l'IPv6 globale sono bloccati."

