#: pervius/ui/window.py:1707
msgid "Block IPv6 while connected"
msgstr "Blocca IPv6 durante la connessione"

#: pervius/ui/window.py:1710
msgid ""
"While the VPN is up, IPv6 traffic outside the tunnel is blocked, even when "
"the kill switch is off. Applies from the next connection."
msgstr ""
