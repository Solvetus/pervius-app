#: pervius/ui/window.py:715
#, python-brace-format
msgid "NetworkManager is unavailable: {0}"
msgstr "NetworkManager non è disponibile: {0}"

#. Translators: {0} is a technical error message.
#: pervius/ui/window.py:733
#, python-brace-format
msgid "The NetworkManager secret agent could not be registered: {0}"
msgstr "Impossibile registrare l'agente dei segreti di NetworkManager: {0}"

#: pervius/ui/window.py:838 pervius/ui/window.py:1036
msgid "The kill-switch service is unavailable."
msgstr "Il servizio del kill switch non è disponibile."

#: pervius/ui/window.py:840
msgid "System service unavailable; the optional package is not active."
msgstr ""
"Servizio di sistema non disponibile: il pacchetto opzionale non è attivo."

#: pervius/ui/window.py:855
msgid "Applying…"
msgstr "Applicazione in corso…"

#: pervius/ui/window.py:858
msgid ""
"The system service reported an error. Disarm, then arm the kill switch again."
msgstr ""
"Il servizio di sistema ha segnalato un errore. Disattivare il kill switch e "
"poi riattivarlo."

#: pervius/ui/window.py:863
#, python-brace-format
msgid "Armed — {0} VPN endpoint allowed; all other traffic is blocked."
msgid_plural "Armed — {0} VPN endpoints allowed; all other traffic is blocked."
msgstr[0] ""
"Attivo — {0} indirizzo di server VPN consentito; tutto il resto del traffico "
"è bloccato."
msgstr[1] ""
"Attivo — {0} indirizzi di server VPN consentiti; tutto il resto del traffico "
"è bloccato."

#: pervius/ui/window.py:868
msgid "Armed — VPN not connected; internet traffic is blocked."
msgstr "Attivo — VPN non connessa; il traffico Internet è bloccato."

#: pervius/ui/window.py:870
msgid "Off — normal network traffic is allowed."
msgstr "Disattivato — il normale traffico di rete è consentito."

#: pervius/ui/window.py:893 pervius/ui/window.py:914 pervius/ui/window.py:1033
#: pervius/ui/window.py:3373
msgid "A kill-switch operation is already in progress."
msgstr "È già in corso un'operazione sul kill switch."

#: pervius/ui/window.py:928
msgid "Local network traffic will remain allowed."
msgstr "Il traffico della rete locale resterà consentito."

#: pervius/ui/window.py:930
msgid "Local network traffic will also be blocked."
msgstr "Anche il traffico della rete locale verrà bloccato."

#: pervius/ui/window.py:933
msgid "Enable the kill switch?"
msgstr "Attivare il kill switch?"

#: pervius/ui/window.py:936
#, python-brace-format
msgid ""
"All traffic outside the VPN will be blocked, including DNS and global IPv6. "
"If the VPN is not connected, normal internet access will stop until you "
"disarm it or connect. {0}"
msgstr ""
"Tutto il traffico esterno alla VPN verrà bloccato, compresi il DNS e l'IPv6 "
"globale. Se la VPN non è connessa, il normale accesso a Internet si "
"interromperà fino alla disattivazione del kill switch o alla connessione. {0}"

#: pervius/ui/window.py:942
msgid "Enable"
msgstr "Attiva"

#: pervius/ui/window.py:956
msgid "Disable the kill switch?"
msgstr "Disattivare il kill switch?"

#: pervius/ui/window.py:958
msgid ""
"The firewall rules will be removed and normal network traffic will be "
"allowed again, even if the VPN is down."
msgstr ""
"Le regole del firewall verranno rimosse e il normale traffico di rete sarà "
"di nuovo consentito, anche se la VPN non è attiva."

#: pervius/ui/window.py:963
msgid "Disable"
msgstr "Disattiva"

