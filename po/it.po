#: pervius/ui/window.py:851
msgid "The system service reported an error. Disarm, then arm the kill switch again."
msgstr "Il servizio di sistema ha segnalato un errore. Disattivare il kill switch e poi riattivarlo."

#: pervius/ui/window.py:856
#, python-brace-format
msgid "Armed — {0} VPN endpoint allowed; all other traffic is blocked."
msgid_plural "Armed — {0} VPN endpoints allowed; all other traffic is blocked."
msgstr[0] "Attivo — {0} indirizzo di server VPN consentito; tutto il resto del traffico è bloccato."
msgstr[1] "Attivo — {0} indirizzi di server VPN consentiti; tutto il resto del traffico è bloccato."

#: pervius/ui/window.py:861
msgid "Armed — VPN not connected; internet traffic is blocked."
msgstr "Attivo — VPN non connessa; il traffico Internet è bloccato."

#: pervius/ui/window.py:863
msgid "Off — normal network traffic is allowed."
msgstr "Disattivato — il normale traffico di rete è consentito."

#: pervius/ui/window.py:886 pervius/ui/window.py:907 pervius/ui/window.py:1026
#: pervius/ui/window.py:3185
msgid "A kill-switch operation is already in progress."
msgstr "È già in corso un'operazione sul kill switch."

#: pervius/ui/window.py:921
msgid "Local network traffic will remain allowed."
msgstr "Il traffico della rete locale resterà consentito."

#: pervius/ui/window.py:923
msgid "Local network traffic will also be blocked."
msgstr "Anche il traffico della rete locale verrà bloccato."

#: pervius/ui/window.py:926
msgid "Enable the kill switch?"
msgstr "Attivare il kill switch?"

#: pervius/ui/window.py:929
#, python-brace-format
msgid "All traffic outside the VPN will be blocked, including DNS and global IPv6. If the VPN is not connected, normal internet access will stop until you disarm it or connect. {0}"
msgstr "Tutto il traffico esterno alla VPN verrà bloccato, compresi il DNS e l'IPv6 globale. Se la VPN non è connessa, il normale accesso a Internet si interromperà fino alla disattivazione del kill switch o alla connessione. {0}"

#: pervius/ui/window.py:935
msgid "Enable"
msgstr "Attiva"

#: pervius/ui/window.py:949
msgid "Disable the kill switch?"
msgstr "Disattivare il kill switch?"

#: pervius/ui/window.py:951
msgid "The firewall rules will be removed and normal network traffic will be allowed again, even if the VPN is down."
msgstr "Le regole del firewall verranno rimosse e il normale traffico di rete sarà di nuovo consentito, anche se la VPN non è attiva."

#: pervius/ui/window.py:956
msgid "Disable"
msgstr "Disattiva"

