#!/bin/sh
# Refuse to replace the pre-rename package (solvetus-vpn 0.1.x) while its
# kill switch is armed.  The previous package's removal would otherwise drop
# the firewall table silently.  This script only looks; it never deletes or
# flushes any table.
#
# Limitation: apt removes the conflicting package before it unpacks this one,
# and the previous package's own postrm deletes its table on removal, so this
# guard is effective for `dpkg -i`, not for `apt install`.  README.md tells
# 0.1.x users to disarm before upgrading.
set -e

case "$1" in
    install|upgrade)
        if command -v nft >/dev/null 2>&1 &&
            nft list table inet solvetus_ks >/dev/null 2>&1; then
            cat >&2 <<'MESSAGE'
pervius: the kill switch of the previous package (solvetus-vpn) is armed:
the nftables table "inet solvetus_ks" exists.

The installation was stopped so that this protection is not removed
silently. Disarm it, then install pervius again:

    solvetus-killswitch disarm
MESSAGE
            if ! command -v solvetus-killswitch >/dev/null 2>&1; then
                echo "If that command is not available, run as root: nft delete table inet solvetus_ks" >&2
            fi
            exit 1
        fi
        ;;
esac

exit 0
