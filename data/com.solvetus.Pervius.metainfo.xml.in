<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.solvetus.Pervius</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>
  <name translate="no">Pervius</name>
  <summary>Unofficial Linux client for FastVPN</summary>
  <description>
    <p>
      Pervius is a GTK 4/libadwaita desktop client for an existing FastVPN
      (OpenVPN) subscription. It downloads the provider's public server
      catalogue, validates every profile strictly, and imports the selected
      profile through NetworkManager and its OpenVPN plugin.
    </p>
    <p>
      The application runs as an ordinary user. NetworkManager performs the
      privileged network operations, and passwords are supplied by a
      NetworkManager secret agent instead of being written into the VPN profile.
      While connected, all DNS goes through the tunnel and IPv6 outside the
      tunnel is blocked. An optional kill switch, backed by a small system
      service and polkit, blocks all other traffic outside the tunnel while it
      is armed.
    </p>
    <p>
      It offers country search with flags, favorites, bounded automatic
      reconnection, a tray icon, desktop notifications, connection details
      such as the VPN exit IP and traffic totals, and English, Portuguese,
      French, Spanish and Italian translations. It manages one NetworkManager
      profile and does not provide auto-protect or DNS filtering.
    </p>
    <p>
      Pervius is an independent open-source project by Solvetus Labs. It is not
      affiliated with, endorsed by, or sponsored by Namecheap, Inc. FastVPN is a
      trademark of Namecheap, Inc.
    </p>
  </description>
  <launchable type="desktop-id">com.solvetus.Pervius.desktop</launchable>
  <developer id="com.solvetus">
    <name translate="no">Solvetus Labs</name>
  </developer>
  <url type="homepage">https://github.com/Solvetus/pervius-app</url>
  <url type="bugtracker">https://github.com/Solvetus/pervius-app/issues</url>
  <url type="vcs-browser">https://github.com/Solvetus/pervius-app</url>
  <url type="contribute">https://github.com/Solvetus/pervius-app/blob/main/CONTRIBUTING.md</url>
  <icon type="stock">com.solvetus.Pervius</icon>
  <branding>
    <color type="primary" scheme_preference="light">#BEE63B</color>
    <color type="primary" scheme_preference="dark">#1B2127</color>
  </branding>
  <translation type="gettext">pervius</translation>
  <categories>
    <category>Network</category>
  </categories>
  <keywords>
    <keyword translate="no">VPN</keyword>
    <keyword translate="no">OpenVPN</keyword>
    <keyword translate="no">NetworkManager</keyword>
    <keyword>kill switch</keyword>
  </keywords>
  <provides>
    <binary>pervius</binary>
    <binary>pervius-killswitch</binary>
    <binary>pervius-inspect</binary>
    <binary>pervius-proof</binary>
  </provides>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="1.0.1" date="2026-11-19" type="stable">
      <url type="details">https://github.com/Solvetus/pervius-app/releases/tag/v1.0.1</url>
      <description>
        <p>
          Security fixes for the kill switch and the leak guard, from an
          independent review of the privileged code.
        </p>
      </description>
    </release>
    <release version="1.0.0" date="2026-11-19" type="stable">
      <url type="details">https://github.com/Solvetus/pervius-app/releases/tag/v1.0.0</url>
      <description>
        <p>
          First public release: a desktop client for an existing FastVPN
          subscription with leak protection while connected, an optional kill
          switch, a tray icon, automatic reconnect and five languages.
        </p>
      </description>
    </release>
  </releases>
</component>
