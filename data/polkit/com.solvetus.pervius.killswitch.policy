<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Solvetus Labs</vendor>
  <vendor_url>https://github.com/Solvetus/pervius-app</vendor_url>
  <action id="com.solvetus.pervius.killswitch.control">
    <description>Control the Pervius kill switch</description>
    <message>An application is requesting to change the system-wide VPN kill switch.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
