[Unit]
Description=Solvetus VPN kill switch
Documentation=file:///usr/share/doc/solvetus-vpn/ARCHITECTURE.md
After=dbus.service NetworkManager.service
Requires=dbus.service

[Service]
Type=dbus
BusName=org.solvetus.KillSwitch1
ExecStart=/usr/bin/python3 -m solvetus.killswitchd.daemon
User=root
Environment=PYTHONUNBUFFERED=1
RuntimeDirectory=solvetus
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/solvetus
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
