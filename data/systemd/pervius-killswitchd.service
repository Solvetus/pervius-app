[Unit]
Description=Pervius VPN kill switch
Documentation=https://github.com/Solvetus/pervius-app/blob/main/docs/ARCHITECTURE.md
After=dbus.service NetworkManager.service
Requires=dbus.service

[Service]
Type=dbus
BusName=com.solvetus.Pervius.KillSwitch1
ExecStart=/usr/bin/python3 -m pervius.killswitchd.daemon
User=root
Environment=PYTHONUNBUFFERED=1
RuntimeDirectory=pervius
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/pervius
StateDirectory=pervius
StateDirectoryMode=0755
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
