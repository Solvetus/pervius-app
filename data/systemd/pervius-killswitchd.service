[Unit]
Description=Pervius VPN kill switch
Documentation=https://github.com/Solvetus/pervius-app/blob/main/docs/ARCHITECTURE.md
After=dbus.service NetworkManager.service
Requires=dbus.service

[Service]
Type=dbus
BusName=com.solvetus.Pervius.KillSwitch1
# -I: isolated mode (no PYTHON* variables, user site or current directory on
# sys.path); -u: unbuffered output for the journal.
ExecStart=/usr/bin/python3 -I -u -m pervius.killswitchd.daemon
User=root
RuntimeDirectory=pervius
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StateDirectory=pervius
StateDirectoryMode=0755
UMask=0077
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/run/pervius
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
